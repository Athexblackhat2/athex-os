#!/bin/sh
set -e

echo "[athex] Applying ATHEX OS branding..."

# --- Plymouth boot splash ---
if command -v update-alternatives >/dev/null 2>&1; then
  update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
    default.plymouth /usr/share/plymouth/themes/athex/athex.plymouth 200 || true
  update-alternatives --set default.plymouth /usr/share/plymouth/themes/athex/athex.plymouth || true
fi
update-initramfs -u || true

# --- Hostname ---
echo "athex-os" > /etc/hostname

# --- GRUB branding ---
if [ -f /etc/default/grub ]; then
  sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="ATHEX OS"/' /etc/default/grub || true
  grep -q '^GRUB_DISTRIBUTOR=' /etc/default/grub || echo 'GRUB_DISTRIBUTOR="ATHEX OS"' >> /etc/default/grub
fi

# --- XFCE default wallpaper (applies to the default/live user profile) ---
mkdir -p /etc/xdg/xfce4/xfconf/xfce-perchannel-xml
cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/athex/wallpaper.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
EOF

# --- LightDM greeter background + logo ---
if [ -d /etc/lightdm ]; then
  mkdir -p /etc/lightdm/lightdm-gtk-greeter.conf.d
  cat > /etc/lightdm/lightdm-gtk-greeter.conf.d/60-athex.conf <<'EOF'
[greeter]
background=/usr/share/backgrounds/athex/wallpaper.png
theme-name=Kali-Dark
icon-theme-name=Flat-Remix-Blue-Dark
font-name=DejaVu Sans 11
EOF
fi

chmod +x /usr/local/bin/athex-about || true

echo "[athex] Branding applied."
